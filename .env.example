############
# Orbit - Environment Variables
############

SESSION_SECRET=your-super-secret-32-char-key # Generate one using https://bitwarden.com/password-generator/ or use openssl rand -hex 32. CHANING THIS WILL RESULT IN ALL SESSIONS BEING ENDED.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE # Leave this blank if you are self hosting with Docker Compose
NEXTAUTH_URL=https://instance.planetaryapp.cloud # Set to your domain/connection string minus end /
ROBLOX_WORKSPACE_REDIRECTID=12345566 # Your Group ID, if the user has access to the workspace, they'll be redirected

# Security hardening (recommended)
# INSTANCE_SETUP_TOKEN=generate-a-long-random-token # Required to run first-time setup in production
# TRUST_PROXY_IP_HEADER=cf-connecting-ip # Only set when a trusted proxy overwrites this header
# ALLOWED_ORIGINS=https://your-domain.com # Explicit origins accepted by CSRF validation

############
# Database - Only required if you are using postgres with Docker Compose
# *Change password in production*
############

# POSTGRES_PASSWORD=supersecretpassword
# POSTGRES_USER=postgres
# POSTGRES_DB=tovy
# POSTGRES_PORT=5432
