{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "objectWrap": "preserve",
  "sortImports": {
    "order": "asc",
    "newlinesBetween": true,
    "ignoreCase": true,
    "sortSideEffects": false,
    "partitionByNewline": false,
    "partitionByComment": false,
    "internalPattern": ["@/**", "~/", "#/**"]
  },
  "sortPackageJson": true,
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "auto",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.output/**",
    "**/.nuxt/**",
    "**/.vite/**",
    "**/generated/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/vendor/**"
  ]
}
