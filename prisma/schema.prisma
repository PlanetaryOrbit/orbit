generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Instance Settings
// These are changed by whoever has the isOwner flag on their account, or on startup.
model InstanceSettings {
  id                 String  @id @default(cuid())
  name               String  @default("Orbit")
  logoUrl            String  @default("/favicon.png")
  allowPasswordAuth  Boolean @default(true)
  allowRobloxAuth    Boolean @default(false)
  enableRegistration Boolean @default(true)
  primaryColor       String  @default("#fb019c")
  darkBackground     String  @default("/orbitbackground-dark.svg")
  lightBackground    String  @default("/orbitbackground-light.svg")
  isSetup            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Signup Attempt - Temporary state for non-OAuth signup.
// Expires after 10 minutes.
model SignupAttempt {
  id               String   @id @default(cuid())
  username         String
  passwordHash     String
  robloxId         BigInt
  verificationCode String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([robloxId])
}

// A user. Need I say more?
model User {
  id            String         @id @default(cuid())
  username      String         @unique
  robloxId      BigInt
  credentials   Credential?
  sessions      Session[]
  notifications Notification[]
  robloxData    Json? // username, displayName, hasVerifiedBadge, isBanned, avatarUrl, syncedAt
  isOwner       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([robloxData])
  @@index([robloxId])
}

model Credential {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  icon        String?
  url         String?
  sentAt      DateTime  @default(now())
  expiresAt   DateTime?
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}
