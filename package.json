{
  "name": "orbit",
  "version": "3.0.0alpha.1",
  "private": false,
  "packageManager": "bun@1.3.14",
  "prisma.schema": "prisma/schema.prisma",
  "scripts": {
    "dev": "bun server.ts --https",
    "start": "NODE_ENV=production bun server.ts",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck",
    "certs": "mkdir -p certs && [ -f certs/key.pem ] && [ -f certs/cert.pem ] || (mkcert -install && mkcert -key-file certs/key.pem -cert-file certs/cert.pem localhost 127.0.0.1 ::1)"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/ws": "^8.18.1",
    "@wrksz/themes": "^1.1.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "ioredis": "^6.0.0",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "^16.3.0",
    "globals": "^17.9.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
